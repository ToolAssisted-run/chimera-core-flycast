{
  "coreName": "Flycast",
  "systemId": "DC",
  "author": "Flyinghead and the Flycast contributors",
  "url": "https://github.com/flyinghead/flycast",
  "romFile": "disc",
  "deterministic": true,
  "memoryLayoutMiB": [
    256,
    16,
    64,
    16,
    256
  ],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. A Dreamcast is BIG: 16MB of system RAM, 16MB of video RAM, 8MB for the AICA and 32MB for the Elan, and with no virtual memory in a sandbox those are ordinary allocations inside the guest heap. Sized like a smaller machine, an allocation fails quietly and the machine writes through a null base.",
  "video": {
    "_comment": "buffer CAPACITY; the live size comes from GetVideoWidth/Height per frame, which follow the tile clip and the scaler registers a game sets. 640x480 is the most a Dreamcast displays.",
    "width": 640,
    "height": 480,
    "virtualWidth": 640,
    "virtualHeight": 480,
    "vsyncNumerator": 60000,
    "vsyncDenominator": 1001,
    "getBgra": "GetVideoBgra"
  },
  "audio": {
    "samplesPerFrame": 1024,
    "channels": 2,
    "get": "GetAudio"
  },
  "lag": {
    "inputWasRead": "InputWasRead"
  },
  "extensions": {
    ".gdi": "DC",
    ".cdi": "DC",
    ".chd": "DC",
    ".cue": "DC",
    ".elf": "DC"
  },
  "input": {
    "name": "Dreamcast Controller",
    "_comment": "The standard controller: a d-pad, four face buttons, Start, and the two analog triggers and stick that make it a Dreamcast pad rather than a Saturn one. The triggers are axes, not buttons, because games read how far they are pressed.",
    "buttons": [
      "A",
      "B",
      "X",
      "Y",
      "Start",
      "Up",
      "Down",
      "Left",
      "Right"
    ],
    "axes": [
      {
        "name": "Stick X",
        "min": -32768,
        "max": 32767,
        "neutral": 0
      },
      {
        "name": "Stick Y",
        "min": -32768,
        "max": 32767,
        "neutral": 0
      },
      {
        "name": "Left Trigger",
        "min": -32768,
        "max": 32767,
        "neutral": -32768
      },
      {
        "name": "Right Trigger",
        "min": -32768,
        "max": 32767,
        "neutral": -32768
      }
    ]
  },
  "settings": [
    {
      "name": "bios",
      "display": "Boot ROM",
      "type": "enum",
      "options": [
        "hle",
        "real"
      ],
      "default": "hle",
      "description": "Which bios the machine runs. 'hle' is Flycast's own reimplementation, which boots most discs and needs no files - it is not the machine Sega shipped, and anything that reads the bios (the boot animation, the settings screens) is only right with the real one. 'real' asks the project for dc_boot.bin and dc_flash.bin. The two are DIFFERENT MACHINES and do not share movies."
    },
    {
      "name": "rtc",
      "display": "Power-on Clock",
      "type": "int",
      "default": 0,
      "min": 0,
      "max": 2147483647,
      "description": "What time the machine believes it is when it wakes, counted from the Dreamcast's own epoch (1 January 1950). A Dreamcast has a battery-backed clock and writes the time into RAM at boot, where the bios and games read it - so a machine that took the wall clock would be a different machine every run, and a movie recorded on one would not replay on another. This pins it, and a movie records the number it ran with. It also decides the console's ID, which some games read."
    },
    {
      "name": "region",
      "display": "Region",
      "type": "enum",
      "options": [
        "japan",
        "usa",
        "europe"
      ],
      "default": "usa",
      "description": "Which Dreamcast this is. The region lives in the machine's flash and a game may check it, refuse to run, or simply pick a language."
    },
    {
      "name": "language",
      "display": "System Language",
      "type": "enum",
      "options": [
        "japanese",
        "english",
        "german",
        "french",
        "spanish",
        "italian"
      ],
      "default": "english",
      "description": "The language set in the machine's own settings, which games read to pick their text."
    },
    {
      "name": "broadcast",
      "display": "Television Standard",
      "type": "enum",
      "options": [
        "ntsc",
        "pal",
        "palM",
        "palN"
      ],
      "default": "ntsc",
      "description": "Which television the machine is wired for. It changes the frame rate and the number of lines drawn, so it is part of the machine rather than a display preference."
    }
  ],
  "firmware": [
    {
      "id": "dc_boot.bin",
      "display": "Dreamcast Boot ROM",
      "description": "The console's own bios, 2MB (the id is the canonical dump filename).",
      "size": 2097152,
      "name": "dc_boot.bin",
      "requiredWhen": {
        "setting": "bios",
        "is": "real"
      }
    },
    {
      "id": "dc_flash.bin",
      "display": "Dreamcast Flash",
      "description": "The machine's flash, 128KB: its region, language, date and console id. With a real bios the machine reads its settings from here rather than from ones the core synthesises.",
      "size": 131072,
      "name": "dc_flash.bin",
      "requiredWhen": {
        "setting": "bios",
        "is": "real"
      }
    }
  ]
}

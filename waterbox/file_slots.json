{
	"_comment": "This file lists the kinds of file a project of this core can hold. Chimera's New Project window is built from it. The core is four machines and each takes its own kind of file, so the Machine setting decides which slots are shown. A Dreamcast project is one disc. A .gdi file names its tracks in other files next to it, so the wizard takes the .gdi and Chimera adds the files it names. An arcade project is a MAME ROM set.",
	"slots": [
		{
			"id": "disc",
			"title": "slot.disc",
			"min": 1,
			"max": 8,
			"formats": [
				"gdi",
				"cdi",
				"chd",
				"cue",
				"elf"
			],
			"help": "slot.disc.help",
			"exposedWhen": {
				"setting": "machine",
				"is": "dreamcast"
			}
		},
		{
			"id": "romset",
			"title": "slot.romset",
			"min": 1,
			"max": 3,
			"formats": [
				"zip",
				"chd",
				"dat",
				"bin",
				"lst"
			],
			"help": "slot.romset.help",
			"exposedWhen": {
				"setting": "machine",
				"in": [
					"naomi",
					"naomi2",
					"atomiswave"
				]
			}
		},
		{
			"id": "savedata",
			"title": "slot.savedata",
			"min": 0,
			"max": 4,
			"formats": [
				"bin"
			],
			"help": "slot.savedata.help",
			"exposedWhen": {
				"setting": "machine",
				"is": "dreamcast"
			},
			"namePattern": "^vmu_[A-D][12]\\.bin$",
			"nameHelp": "slot.savedata.name_help"
		},
		{
			"id": "boardmemory",
			"title": "slot.boardmemory",
			"min": 0,
			"max": 4,
			"formats": [
				"eeprom",
				"nvmem",
				"bin"
			],
			"help": "slot.boardmemory.help",
			"exposedWhen": {
				"setting": "machine",
				"in": [
					"naomi",
					"naomi2",
					"atomiswave"
				]
			},
			"namePattern": "\\.(eeprom|nvmem|nvmem2)$|^vmu_[A-D][12]\\.bin$",
			"nameHelp": "slot.boardmemory.name_help"
		}
	]
}

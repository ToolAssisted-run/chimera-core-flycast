+/* chimera: a machine whose clock is the wall clock is a DIFFERENT MACHINE
+ * every time it is powered on, and a movie recorded on one does not replay on
+ * another - the Dreamcast writes the time into RAM at boot, and the bios and
+ * games read it. A host that needs the machine to be a function of its project
+ * pins the time here; weakly declared, so everyone else keeps the clock. */
+extern "C" int chimera_pinned_rtc(u32 *rtc) __attribute__((weak));
+extern "C" int chimera_pinned_rtc(u32 *rtc) { (void)rtc; return 0; }

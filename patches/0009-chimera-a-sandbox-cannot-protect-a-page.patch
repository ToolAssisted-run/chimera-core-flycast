+#ifdef CHIMERA_NO_PAGE_PROTECTION
+// chimera: is any texture watching this page?
+//
+// Upstream never needs to ask: it PROTECTS the page and lets the fault handler
+// tell it. A sandboxed guest can neither protect a page nor take a fault, so
+// the write path asks instead - on every VRAM write, which is why this has to
+// be cheap. It reads the list without the mutex, which is safe here for the
+// reason the whole sandbox is single-threaded: there is no other thread to
+// race with.
+bool VramLockedPage(size_t offset)
+{
+	if (offset >= VRAM_SIZE || VramLocks == nullptr)
+		return false;
+	return !VramLocks[offset / PAGE_SIZE].empty();
+}
+#endif

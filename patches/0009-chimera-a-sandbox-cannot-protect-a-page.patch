diff --git a/core/hw/pvr/pvr_mem.cpp b/core/hw/pvr/pvr_mem.cpp
index 4b809d6..8688e03 100644
--- a/core/hw/pvr/pvr_mem.cpp
+++ b/core/hw/pvr/pvr_mem.cpp
@@ -5,6 +5,29 @@
 	Most of this was hacked together when i needed support for YUV-dma for thps2 ;)
 */
 #include "pvr_mem.h"
+
+// chimera: a texture in VRAM that the game overwrites must stop being used.
+//
+// Upstream learns that by PROTECTING the texture's pages and catching the
+// fault (core/linux/common.cpp answers SIGSEGV with VramLockedWrite). A
+// sandboxed guest has no page protection and no signal handler, so it never
+// finds out: the first version of this core drew a game's first textures
+// correctly and then showed them for the rest of the run, which in Street
+// Fighter Zero 3 - a game of paletted sprites reusing one region of VRAM -
+// looked like the picture had been through a shredder.
+//
+// So the write path says so itself. The test is one comparison on a page that
+// nothing is watching, which is nearly all of them.
+#ifdef CHIMERA_NO_PAGE_PROTECTION
+#include "rend/TexCache.h"
+static inline void chimera_vram_written(u32 offset)
+{
+	if (VramLockedPage(offset))
+		VramLockedWriteOffset(offset);
+}
+#else
+#define chimera_vram_written(offset) ((void)0)
+#endif
 #include "Renderer_if.h"
 #include "ta.h"
 #include "hw/holly/sb.h"
@@ -101,6 +124,7 @@ static void YUV_ConvertMacroBlock(const u8 *datap)
 	TA_YUV_TEX_CNT++;
 
 	YUV_Block384(datap, &vram[YUV_dest]);
+	chimera_vram_written(YUV_dest);
 
 	YUV_dest+=32;
 
@@ -231,6 +255,7 @@ void DYNACALL pvr_write32p(u32 addr, T data)
 		fb_dirty = true;
 
 	*(T *)&vram[pvr_map32(addr)] = data;
+	chimera_vram_written(pvr_map32(addr));
 }
 template void pvr_write32p<u8, false>(u32 addr, u8 data);
 template void pvr_write32p<u8, true>(u32 addr, u8 data);
@@ -270,6 +295,7 @@ void DYNACALL TAWriteSQ(u32 address, const SQBuffer *sqb)
 		if (path64b)
 		{
 			// 64b path
+			chimera_vram_written(address_w & VRAM_MASK);
 			SQBuffer *dest = (SQBuffer *)&vram[address_w & VRAM_MASK];
 			*dest = *sq;
 		}
@@ -324,9 +350,14 @@ void DYNACALL pvr_write_area4(u32 addr, T data)
 {
 	bool access32 = (upper ? SB_LMMODE1 : SB_LMMODE0) == 1;
 	if (access32)
+	{
 		pvr_write32p(addr, data);
+	}
 	else
+	{
 		*(T*)&vram[addr & VRAM_MASK] = data;
+		chimera_vram_written(addr & VRAM_MASK);
+	}
 }
 template void pvr_write_area4<u8, false>(u32 addr, u8 data);
 template void pvr_write_area4<u16, false>(u32 addr, u16 data);

 		if (path64b)
 		{
 			// 64b path
+			chimera_vram_written(address_w & VRAM_MASK);
 			SQBuffer *dest = (SQBuffer *)&vram[address_w & VRAM_MASK];
 			*dest = *sq;
 		}
@@ -299,10 +325,49 @@ static u32 pvr_map32(u32 offset32)
 	rv |= (offset32 & offset_bits) * 2;
 
 	rv |= bank * 4;
-	
+
 	return rv;
 }
 
+#ifdef CHIMERA_NO_PAGE_PROTECTION
+// The same news as chimera_vram_written, for a whole range at once.
+//
+// Every DMA into vram - the PVR-DMA, and the ch2-DMA direct texture path a
+// game uses to stream sprites - ends in a memcpy inside
+// WriteMemBlock_nommu_*. No handler runs, so the per-write hook never fires
+// and the texture cache goes on showing what used to be there. Under a page
+// protection that memcpy faults like anything else, which is why upstream
+// has nothing here to copy.
+static void chimera_invalidate_pages(u32 offset, u32 size)
+{
+	if (offset >= VRAM_SIZE)
+		return;
+	if (size > VRAM_SIZE - offset)
+		size = VRAM_SIZE - offset;
+
+	for (u32 page = offset & ~(PAGE_SIZE - 1); page < offset + size; page += PAGE_SIZE)
+		if (VramLockedPage(page))
+			VramLockedWriteOffset(page);
+}
+
+void chimera_vram_written_range(u32 addr, u32 size)
+{
+	u32 paddr = addr & 0x1FFFFFFF;
+	if (((paddr >> 26) & 7) != 1 || size == 0)	// area 1 is vram, and only it
+		return;
+
+	// Both windows onto vram are in reach here, and which one a write takes
+	// depends on SB_LMMODE as well as the address, so cover both readings:
+	// invalidating a page that did not change costs one texture upload,
+	// missing one costs the picture.
+	chimera_invalidate_pages(paddr & VRAM_MASK, size);
+	if ((paddr & 0x01000000) == 0)
+		// The 64-bit window interleaves the two banks every 32 bits, so a
+		// range of it covers twice as much vram, starting where it maps.
+		chimera_invalidate_pages(pvr_map32(paddr & VRAM_MASK), size * 2);
+}
+#endif
+
 template<typename T, bool upper>
 T DYNACALL pvr_read_area4(u32 addr)
 {
@@ -324,9 +389,14 @@ void DYNACALL pvr_write_area4(u32 addr, T data)
 {
 	bool access32 = (upper ? SB_LMMODE1 : SB_LMMODE0) == 1;
 	if (access32)
+	{
 		pvr_write32p(addr, data);
+	}
 	else
+	{
 		*(T*)&vram[addr & VRAM_MASK] = data;
+		chimera_vram_written(addr & VRAM_MASK);
+	}
 }
 template void pvr_write_area4<u8, false>(u32 addr, u8 data);
 template void pvr_write_area4<u16, false>(u32 addr, u16 data);

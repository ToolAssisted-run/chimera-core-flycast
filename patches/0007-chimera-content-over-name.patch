+/* chimera: whether this file is a naked SH4 binary, by its four magic bytes
+ * rather than by its name. A sandboxed core is handed its content under a fixed
+ * mount name with no extension at all, and the magic is a better answer than a
+ * name anyway. */
+bool isElfContent(const std::string& path)
+{
+	FILE *probe = nowide::fopen(path.c_str(), "rb");
+	if (probe == nullptr)
+		return false;
+	char magic[4] = {0};
+	const bool isElf = std::fread(magic, 1, sizeof(magic), probe) == sizeof(magic)
+		&& memcmp(magic, "\x7f" "ELF", 4) == 0;
+	std::fclose(probe);
+	return isElf;
+}

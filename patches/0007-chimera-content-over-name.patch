+/* chimera: whether a driver should even look at this file.
+ *
+ * Every driver refuses a path whose extension is not its own, which is fine
+ * when files have names. A sandboxed core is handed its content under a fixed
+ * mount name with no extension at all, and then nothing matches and the disc
+ * is "an unknown format" - though every driver here validates what it reads
+ * anyway. So an UNKNOWN extension now means "look at the file", while a known
+ * one still belongs to exactly one driver.
+ */
+bool discExtensionAllows(const char *file, const char *ext)
+{
+	const std::string actual = get_file_extension(file);
+	if (actual == ext)
+		return true;
+	for (const char *known : { "chd", "gdi", "cdi", "cue", "elf" })
+		if (actual == known)
+			return false;
+	return true;
+}
+
 Disc* OpenDisc(const std::string& path, std::vector<u8> *digest)
 {
+	/* chimera: when the name told us nothing (see discExtensionAllows), every
+	 * driver gets a look - and one that rejects what it finds must DECLINE
+	 * rather than end the load, because the next may be the right one. A named
+	 * file still fails loudly: a corrupt .chd is a corrupt .chd, not an
+	 * invitation to try the .cue reader on it. */
+	const bool sniffing = discExtensionAllows(path.c_str(), "");
 	for (auto driver : drivers)
 	{
-		Disc *disc = driver(path.c_str(), digest);
+		Disc *disc = nullptr;
+		if (sniffing)
+		{
+			try {
+				disc = driver(path.c_str(), digest);
+			} catch (const FlycastException&) {
+				continue;
+			}
+		}
+		else
+		{
+			disc = driver(path.c_str(), digest);
+		}
 
 		if (disc != nullptr)
 			return disc;

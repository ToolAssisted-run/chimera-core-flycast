+// chimera: the block writers are how a game DMAs into RAM, and RAM is where
+// its code lives. Same reason as the single-write hook in addrspace.cpp, and
+// the same no-op with the interpreter.
+#include "hw/sh4/dyna/blockmanager.h"
+static inline void chimera_code_written_range(void *p, u32 size)
+{
+	if (p == nullptr || size == 0)
+		return;
+	u8 *b = (u8 *)p;
+	// one call per page it spans, plus the last byte, because a block can start
+	// and end mid-page
+	for (u32 off = 0; off < size; off += PAGE_SIZE)
+		bm_RamWriteAccess(b + off);
+	bm_RamWriteAccess(b + size - 1);
+}

+// chimera: code the game rewrites must stop being executed.
+//
+// Upstream learns that by PROTECTING the pages a compiled block came from and
+// catching the fault (bm_LockPage -> virtmem::region_lock, answered by the
+// platform's SIGSEGV handler). A sandboxed guest has neither, so the write path
+// says so itself - the same answer patch 0009 gives the texture cache, for the
+// same reason.
+//
+// The cost is one call on every write that lands in memory, and inside it a
+// range check against system RAM followed by a byte lookup in a per-page table
+// that is already true for nearly every page. With the interpreter this is not
+// compiled at all: blockmanager.h defines these as inline no-ops when
+// FEAT_SHREC is DYNAREC_NONE.
+#include "hw/sh4/dyna/blockmanager.h"
+#include "hw/sh4/sh4_mem.h"
+static inline void chimera_code_written(void *p)
+{
+#if FEAT_SHREC != DYNAREC_NONE
+	// Inline, because this is on every write that lands in memory. Two tests
+	// and no call in the case that is almost always taken: writes outside
+	// system RAM are not code, and a page that has already been written to is
+	// not protected and never becomes protected again. The out-of-line part
+	// runs once per page for the life of the cache.
+	u8 *b = (u8 *)p;
+	if (b < &mem_b[0] || b >= &mem_b[RAM_SIZE])
+		return;
+	const u32 off = (u32)(b - &mem_b[0]);
+	if (!bm_IsRamPageProtected(off))
+		return;
+	bm_RamWriteAccess(off);
+#else
+	(void)p;
+#endif
+}

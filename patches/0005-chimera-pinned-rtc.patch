+ * pins the time here; weakly declared, so everyone else keeps the clock. */
+extern "C" int chimera_pinned_rtc(u32 *rtc) __attribute__((weak));
+extern "C" int chimera_pinned_rtc(u32 *rtc) { (void)rtc; return 0; }

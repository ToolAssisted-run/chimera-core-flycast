@@ -177,7 +177,10 @@ public:
 			return "/";
 #endif
 		if (lastSlash == std::string::npos)
-			return "." + native_separator;
+			// chimera: "" rather than "./" - they mean the same directory, and
+			// joining the second onto a filename produces "./name", which a

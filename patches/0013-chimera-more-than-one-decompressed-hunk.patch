+	// chimera: a handful of decompressed hunks, not one.
+	//
+	// A hunk is ~8 sectors of LZMA-compressed, ECC-protected data, and the
+	// reader kept exactly one decompressed. That is fine while a game reads
+	// forward, and catastrophic the moment it alternates: two interleaved
+	// streams - code from one place, data from another - re-decompress a whole
+	// hunk on EVERY sector read. Callgrind on a run that fell into that pattern
+	// put 87% of the entire process in LzmaDec_DecodeReal2 and ecc_compute_bytes.
+	//
+	// A few entries turn that back into what a single stream already got. It is
+	// pure cache: same bytes, same order, no behavioural change - what a disc
+	// returns cannot depend on what was read before it.
+	static constexpr u32 HUNK_CACHE = 8;
+	u8 *hunk_mem = nullptr;              // HUNK_CACHE hunks, back to back
+	u32 cached_hunk[HUNK_CACHE];         // which hunk each slot holds
+	bool cached_valid[HUNK_CACHE] = {};
+	u32 cache_next = 0;                  // round robin: no recency to keep
 
 	u32 hunkbytes = 0;
 	u32 sph = 0;
 
+	// The decompressed hunk for `hunk`, or nullptr if it cannot be read.
+	u8 *hunkData(u32 hunk)
+	{
+		for (u32 i = 0; i < HUNK_CACHE; i++)
+			if (cached_valid[i] && cached_hunk[i] == hunk)
+				return hunk_mem + (size_t)i * hunkbytes;
+
+		const u32 slot = cache_next;
+		cache_next = (cache_next + 1) % HUNK_CACHE;
+		u8 *p = hunk_mem + (size_t)slot * hunkbytes;
+		cached_valid[slot] = false;
+		if (chd_read(chd, hunk, p) != CHDERR_NONE)
+			return nullptr;
+		cached_hunk[slot] = hunk;
+		cached_valid[slot] = true;
+		return p;
+	}
+

diff --git a/core/rend/gles/chimera-no-imgui.h b/core/rend/gles/chimera-no-imgui.h
new file mode 100644
index 0000000..8430ddd
--- /dev/null
+++ b/core/rend/gles/chimera-no-imgui.h
@@ -0,0 +1,11 @@
+#pragma once
+// chimera: what stands in for ui/imgui_driver.h in a core.
+//
+// The GL renderer includes that header for two calls, both of which this
+// build compiles out (see patches/0008): telling the ImGui driver a frame
+// was rendered, and drawing the OSD over it. Nothing else in the renderer
+// wants anything from the user interface, so nothing else needs to be here.
+//
+// It is a file rather than nothing at all because gles.h has to include
+// SOMETHING, and a header that says why is worth more than an #ifdef that
+// does not.
diff --git a/core/rend/gles/gles.cpp b/core/rend/gles/gles.cpp
index aaecb6c..faaa640 100644
--- a/core/rend/gles/gles.cpp
+++ b/core/rend/gles/gles.cpp
@@ -1055,8 +1055,10 @@ void OpenGLRenderer::drawOSD()
 {
 	drawVmusAndCrosshairs(width, height);
 #ifndef LIBRETRO
+#ifndef CHIMERA_NO_IMGUI
 	gui_display_osd();
 #endif
+#endif
 }
 
 void OpenGLRenderer::Process(TA_context* ctx)
diff --git a/core/rend/gles/gles.h b/core/rend/gles/gles.h
index 9082a5d..d2930a0 100755
--- a/core/rend/gles/gles.h
+++ b/core/rend/gles/gles.h
@@ -8,8 +8,15 @@
 #include "rend/shader_util.h"
 #include "rend/transform_matrix.h"
 #ifndef LIBRETRO
+// chimera: a core has no on-screen UI. The GL renderer touches it in exactly
+// two places - telling the ImGui driver a frame was rendered, and drawing the
+// OSD - and dragging ImGui into a sandboxed guest for that would be absurd.
+#ifdef CHIMERA_NO_IMGUI
+#include "rend/gles/chimera-no-imgui.h"
+#else
 #include "ui/imgui_driver.h"
 #endif
+#endif
 
 #include <unordered_map>
 #include <glm/glm.hpp>
@@ -521,7 +528,9 @@ struct OpenGLRenderer : Renderer
 		if (!frameRendered || clearLastFrame)
 			return false;
 #ifndef LIBRETRO
+#ifndef CHIMERA_NO_IMGUI
 		imguiDriver->setFrameRendered();
+#endif
 #endif
 		frameRendered = false;
 		return true;

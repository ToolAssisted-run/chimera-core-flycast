+#ifdef CHIMERA_GUEST_VK
+bool VulkanContext::GetLastFrame(std::vector<u8>& data, int& width, int& height)
+{
+	if (chimeraLastImage < 0 || chimeraLastImage >= (int)colorAttachments.size())
+		return false;
+	FramebufferAttachment *attachment = colorAttachments[chimeraLastImage].get();
+	if (attachment == nullptr || attachment->GetBufferData() == nullptr)
+		return false;
+	// the copy is in the commands of the frame that drew it
+	queue.waitIdle();
+	const vk::Extent2D extent = attachment->getExtent();
+	width = (int)extent.width;
+	height = (int)extent.height;
+	static std::vector<u8> rgba;
+	rgba.resize((size_t)width * height * 4);
+	attachment->GetBufferData()->download((u32)rgba.size(), rgba.data());
+	data.resize((size_t)width * height * 3);
+	const u8 *src = rgba.data();
+	u8 *dst = data.data();
+	for (size_t i = 0, n = (size_t)width * height; i < n; i++, src += 4, dst += 3)
+	{
+		dst[0] = src[0];
+		dst[1] = src[1];
+		dst[2] = src[2];
+	}
+	return true;
+}
+#endif

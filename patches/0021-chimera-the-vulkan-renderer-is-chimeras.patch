 	void UnmapMemory() const
 	{
+#ifdef CHIMERA_GUEST_VK
+		// chimera: memory that stays mapped (a small texture's image, written
+		// in place) is not coherent through Chimera's Vulkan bridge either. It
+		// is not unmapped here, and what was written still has to be sent.
+		// Without this such a texture stayed black: Marvel vs. Capcom 2's
+		// background is one polygon with an 8x8 texture.
+		if (allocInfo.pMappedData != nullptr)
+		{
+			vmaFlushAllocation(allocator, allocation, 0, VK_WHOLE_SIZE);
+			return;
+		}
+#endif
 		if (allocInfo.pMappedData != nullptr)
 			return;
 		VkMemoryPropertyFlags flags;
 		vmaGetMemoryTypeProperties(allocator, allocInfo.memoryType, &flags);
+#ifdef CHIMERA_GUEST_VK
+		// chimera: whatever is not coherent, cached or not
+		if ((flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) == 0)
+#else
 		if ((flags & VK_MEMORY_PROPERTY_HOST_CACHED_BIT) && (flags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) == 0)
+#endif
+#ifdef CHIMERA_GUEST_VK
+			vmaFlushAllocation(allocator, allocation, 0, VK_WHOLE_SIZE);
+#else
 			vmaFlushAllocation(allocator, allocation, allocInfo.offset, allocInfo.size);
+#endif
 		vmaUnmapMemory(allocator, allocation);
 	}
 
